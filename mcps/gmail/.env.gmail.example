MCP_NAME=gmail
HOST=0.0.0.0
PORT=8008

# ─── OAuth 인증 ──────────────────────────────────────────
# 1) Google Cloud Console → OAuth 2.0 클라이언트 ID 발급
#    (Application type: Desktop app)
#    Gmail API 를 같은 프로젝트에서 활성화해야 합니다:
#    https://console.cloud.google.com/apis/library/gmail.googleapis.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2) refresh_token 발급 (1회만)
#    a. https://developers.google.com/oauthplayground 접속
#    b. 우측 톱니바퀴 → "Use your own OAuth credentials" 체크
#       → 위 CLIENT_ID/SECRET 입력
#    c. 좌측 스크롤 → "Gmail API v1" → 아래 스코프를 선택:
#       https://www.googleapis.com/auth/gmail.modify
#       (이 한 스코프로 검색/읽기/보내기/라벨변경/휴지통이 모두 가능합니다.
#        영구 삭제까지 필요하면 gmail.modify 대신 https://mail.google.com/ 사용.)
#    d. "Authorize APIs" 클릭 → 본인 Google 계정 로그인 & 동의
#    e. "Exchange authorization code for tokens" 클릭
#    f. 응답의 refresh_token 값을 아래에 붙여넣기
#
# ⚠️ 캘린더용 refresh_token 은 Gmail 스코프가 없으므로 그대로 사용할 수 없습니다.
#    Gmail 스코프로 다시 발급받아야 합니다.
GOOGLE_REFRESH_TOKEN=