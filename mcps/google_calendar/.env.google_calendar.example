MCP_NAME=google_calendar
HOST=0.0.0.0
PORT=8002

# 작업 대상 캘린더 ID
# - primary : 본인 Google 계정의 기본 캘린더
# - 또는 example@group.calendar.google.com 같은 캘린더 ID
GOOGLE_CALENDAR_ID=primary

# ─── OAuth 인증 ──────────────────────────────────────────
# 1) Google Cloud Console → OAuth 2.0 클라이언트 ID 발급
#    (Application type: Desktop app)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2) refresh_token 발급 (1회만)     
#    a. https://developers.google.com/oauthplayground 접속
#    b. 우측 톱니바퀴 → "Use your own OAuth credentials" 체크
#       → 위 CLIENT_ID/SECRET 입력
#    c. 좌측 스크롤 → "Google Calendar API v3" →
#       https://www.googleapis.com/auth/calendar 선택
#    d. "Authorize APIs" 클릭 → 본인 Google 계정 로그인 & 동의
#    e. "Exchange authorization code for tokens" 클릭
#    f. 응답의 refresh_token 값을 아래에 붙여넣기
GOOGLE_REFRESH_TOKEN=