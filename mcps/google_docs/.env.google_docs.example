MCP_NAME=google_docs
HOST=0.0.0.0
PORT=8001
FASTMCP_TRANSPORT=streamable-http
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8001

# 작업 대상 Drive 폴더 ID
# Google Docs 생성 시 기본으로 사용할 폴더입니다.
# 예: https://drive.google.com/drive/folders/abc123 의 abc123
GOOGLE_DRIVE_DEFAULT_FOLDER_ID=

# OAuth 인증
# 1) Google Cloud Console -> OAuth 2.0 클라이언트 ID 발급
#    Application type: Desktop app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2) refresh_token 발급
#    a. https://developers.google.com/oauthplayground 접속
#    b. 우측 톱니바퀴 -> "Use your own OAuth credentials" 체크
#       -> 위 CLIENT_ID/SECRET 입력
#    c. 좌측에서 Google Docs API v1, Google Drive API v3 scope 선택
#       https://www.googleapis.com/auth/documents
#       https://www.googleapis.com/auth/drive
#    d. "Authorize APIs" 클릭 -> Google 계정 로그인 및 동의
#    e. "Exchange authorization code for tokens" 클릭
#    f. 응답의 refresh_token 값을 아래에 붙여넣기
GOOGLE_REFRESH_TOKEN=
